# Copia este archivo a `.env` y completalo con los valores de tu proyecto.
# `.env` esta en .gitignore y NO debe commitearse.
#
# Para builds de release usa --dart-define (el archivo .env no viaja en el bundle):
#   flutter run --dart-define=SUPABASE_URL=https://xxx.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=tu-anon-key
#
# La SUPABASE_ANON_KEY es publica por diseno (RLS protege los datos). JAMAS
# pongas aca la service_role key ni el password de postgres.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
