{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Registro de usuario en Noveles",
    "locale": "en",
    "visual_preset": "classic",
    "quality_profile": "standard",
    "animation": "trace",
    "viewBox": [
      1500,
      1100
    ],
    "column_fit": "spread",
    "views": [
      {
        "id": "signup",
        "label": "SignUp → sesión",
        "focus": [
          "usr",
          "register",
          "bloc",
          "usecases",
          "repo",
          "authgw",
          "supabase"
        ],
        "note": "El formulario viaja RegisterScreen → AuthBloc → Register → AuthRepository → AuthGateway → Supabase Auth."
      },
      {
        "id": "perfil",
        "label": "Creación de profiles",
        "focus": [
          "repo",
          "datagw",
          "profiles"
        ],
        "note": "El trigger on_auth_user_created crea el perfil; el repo lo verifica y lo crea si faltó (fallback con rol user)."
      },
      {
        "id": "routing",
        "label": "Routing post-registro",
        "focus": [
          "bloc",
          "app",
          "usr"
        ],
        "note": "AuthAuthenticated llega al router y _homeFor elige la home según el rol."
      }
    ]
  },
