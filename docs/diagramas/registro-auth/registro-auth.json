  "cards": [
    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "signUp crea la sesión y la identidad vuelve por el gateway",
        "El trigger on_auth_user_created crea profiles con rol user",
        "El repositorio verifica y, si el perfil falta, lo inserta como fallback"
      ]
    },
    {
      "dot": "rose",
      "title": "Fallos",
      "items": [
        "register fallido → AuthError → SnackBar sin sacar al usuario",
        "El formulario valida confirmación de password en UI",
        "Rol absent o unknown nunca llega a una pantalla autenticada"
      ]
    },
    {
      "dot": "orange",
      "title": "Doble vía del perfil",
      "items": [
        "profiles_extended agrega display_name · bio · avatar_url",
        "add_email_to_profiles backfillea email desde auth.users",
        "El stream de auth mantiene el estado tras el registro"
      ]
    }
  ]
