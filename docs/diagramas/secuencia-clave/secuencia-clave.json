{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Login y ruteo por rol",
    "subtitle": "Credenciales → sesión → profiles → pantalla según rol · expiración de token vía stream",
    "output": "docs/diagramas/secuencia-clave/secuencia-clave.html",
    "viewBox": [
      1500,
      1160
    ],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "credenciales",
        "label": "Credenciales → sesión",
        "focus": [
          "user",
          "login",
          "bloc",
          "usecases",
          "repo",
          "authgw",
          "supabase"
        ],
        "note": "Sigue el email+password desde la pantalla hasta Supabase Auth y la sesión que vuelve."
      },
      {
        "id": "profiles",
        "label": "Carga / creación de profiles",
        "focus": [
          "repo",
          "datagw",
          "profiles"
        ],
        "note": "El perfil se lee de Postgres; si no existe se crea con rol user y se verifica."
      },
      {
        "id": "routing",
        "label": "Selección de pantalla por rol",
        "focus": [
          "usecases",
          "bloc",
          "app",
          "user"
        ],
        "note": "AuthAuthenticated llega al router, que elige la home según isAdmin / isScan / isUser."
      },
      {
        "id": "expiracion",
        "label": "Expiración de token",
        "focus": [
          "supabase",
          "authgw",
          "repo",
          "bloc",
          "app",
          "user"
        ],
        "note": "El stream avisa signedOut y el logout automático vuelve a LoginScreen."
      }
    ]
  },
