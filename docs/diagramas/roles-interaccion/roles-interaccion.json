{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Interacción por rol en Noveles",
    "subtitle": "Qué ve y qué hace cada rol sobre la misma plataforma — permisos RLS diferenciados por lane",
    "locale": "en",
    "visual_preset": "classic",
    "quality_profile": "standard",
    "animation": "trace",
    "viewBox": [
      1620,
      1080
    ],
    "views": [
      {
        "id": "lectura",
        "label": "Rol user · lector",
        "focus": [
          "login_user",
          "main_user",
          "favoritos",
          "recientes",
          "perfil_user",
          "db_user"
        ],
        "note": "El lector ve solo libros con is_visible = true y gestiona favoritos, recientes, marcado de leído y su perfil."
      },
      {
        "id": "ingesta",
        "label": "Rol scan · ingesta",
        "focus": [
          "login_scan",
          "scan_main",
          "tooks",
          "capitulos",
          "upload",
          "covers",
          "db_scan"
        ],
        "note": "El scan crea y edita contenido propio: libros, tooks, capítulos con upload al bucket y portadas."
      },
      {
        "id": "gestion",
        "label": "Rol admin · gestión",
        "focus": [
          "login_admin",
          "admin_dash",
          "usuarios",
          "generos",
          "etiquetas",
          "analytics",
          "db_admin"
        ],
        "note": "El admin gestiona usuarios (roles y suspensión), géneros, etiquetas y analytics de book_views."
      },
      {
        "id": "suspension",
        "label": "Acceso suspendido",
        "focus": [
          "suspended",
          "login_sus",
          "login_user",
          "login_scan",
          "login_admin"
        ],
        "note": "Un rol suspendido pierde la sesión (RESTRICTIVE RLS) y cae de nuevo en LoginScreen."
      }
    ]
  },
  "lanes": [
    {
      "id": "user_lane",
      "label": "Rol user · lector"
    },
    {
      "id": "scan_lane",
      "label": "Rol scan · ingesta"
    },
    {
      "id": "admin_lane",
      "label": "Rol admin · gestión"
    },
    {
      "id": "sus_lane",
      "label": "Rol suspended · sin acceso",
      "variant": "exception"
    },
    {
      "id": "storage_lane",
      "label": "Supabase Storage"
    },
    {
      "id": "db_lane",
      "label": "Postgres · RLS"
    }
  ],
  "mainPath": [
    "login_user",
    "main_user",
    "favoritos",
    "db_user"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "login_user",
      "login_scan",
      "login_admin",
      "suspended"
    ],
    "allowedTerminals": [
      "db_user",
      "db_scan",
      "db_admin",
      "upload",
      "covers",
      "recientes",
      "perfil_user",
      "generos",
      "etiquetas",
      "analytics",
      "login_sus"
    ],
    "requiredEdges": [
      {
        "from": "login_user",
        "to": "main_user"
      },
      {
        "from": "login_scan",
        "to": "scan_main"
      },
      {
        "from": "login_admin",
        "to": "admin_dash"
      },
      {
        "from": "suspended",
        "to": "login_sus"
      }
    ]
  },
  "nodes": [
    {
