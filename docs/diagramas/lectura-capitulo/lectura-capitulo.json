  "cards": [
    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "ChapterCache en disco (TTL 7 días) evita re-descargar de Storage",
        "ChapterBloc precarga los 3 adyacentes en paralelo",
        "Al 80% del scroll se marca leído con inserción en chapter_reads"
      ]
    },
    {
      "dot": "rose",
      "title": "Fallos y duplicados",
      "items": [
        "chapter_reads tiene PK (user_id, chapter_id): el INSERT duplicado lanza Err",
        "El guard _markedChapters hace idempotente el marcado dentro de la pantalla",
        "MarkChapterAsRead no pasa por el bloc: lo dispara la pantalla directo"
      ]
    },
    {
      "dot": "orange",
      "title": "Tracking y analytics",
      "items": [
        "track_book_view NO se dispara al leer: BookViewTracker usa un Timer 2s en BookScreen",
        "chapter_reads alimenta agregados y la RPC get_user_recent_views",
        "Recientes (UI) ≠ analytics agregados"
      ]
    }
  ]
