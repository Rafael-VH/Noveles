  "cards": [
    {
      "dot": "cyan",
      "title": "Seam único al vendor",
      "items": [
        "DataGateway.rpc(function, params) es el port (data_gateway.dart)",
        "SupabaseDataGateway es el único lugar que conoce PostgREST",
        "Los repos llaman rpc('nombre', params) directo sobre el port"
      ]
    },
    {
      "dot": "amber",
      "title": "Seguridad",
      "items": [
        "Todas las RPCs de negocio: SECURITY DEFINER + SET search_path = ''",
        "Role check is_admin()/is_scan()/is_user() dentro de cada función",
        "REVOKE EXECUTE FROM PUBLIC → GRANT authenticated (dashboard usa anon key pero llega como authenticated)"
      ]
    },
    {
      "dot": "violet",
      "title": "Mapa de funciones",
      "items": [
        "book_relations: create_book_with_relations · update_book_with_relations",
        "Analytics: get_views_trend · get_top_books · get_analytics_overview",
        "user: get_user_recent_views · get_most_viewed_books_public · is_user()",
        "admin: admin_suspend_user · admin_reactivate_user"
      ]
    },
    {
      "dot": "rose",
      "title": "Obsolescencias",
      "items": [
        "get_most_viewed_books (admin-only) quedó sin grants; no se usa desde Dart",
        "get_user_recent_views no tiene REVOKE/GRANT explícito (heredó PUBLIC)",
        "No existe 'book_relations' ni 'ediciones_por_volumen' como funciones"
      ]
    }
  ]
