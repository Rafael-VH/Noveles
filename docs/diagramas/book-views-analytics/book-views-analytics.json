{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Vistas y lecturas hacia Analytics",
    "locale": "en",
    "visual_preset": "classic",
    "quality_profile": "standard",
    "animation": "trace",
    "viewBox": [
      1920,
      1000
    ],
    "views": [
      {
        "id": "tracking",
        "label": "Tracking en origen",
        "focus": [
          "chapter_screen",
          "book_screen",
          "track_uc",
          "mark_read_uc",
          "views_db",
          "reads_db"
        ],
        "note": "El cliente genera los eventos: abrir libro inserta book_views y marcar leído inserta chapter_reads."
      },
      {
        "id": "agregados",
        "label": "Agregados por RPC",
        "focus": [
          "views_db",
          "reads_db",
          "rpcs"
        ],
        "note": "Las funciones de analytics agregan book_views y chapter_reads en el servidor."
      },
      {
        "id": "consumo",
        "label": "Consumo admin",
        "focus": [
          "rpcs",
          "admin_bloc",
          "analytics_tab"
        ],
        "note": "El AdminAnalyticsBloc consume las RPCs y pinta AnalyticsTab."
      }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "Origen del dato",
      "items": [
        "Abrir libro → INSERT book_views (track_book_view)",
        "Marcar leído → INSERT chapter_reads (mark_chapter_as_read)",
        "Los eventos nacen en el cliente, nunca se llenan a mano"
      ]
    },
    {
      "dot": "violet",
      "title": "Agregación en servidor",
      "items": [
        "get_analytics_overview · overview global",
        "get_views_trend(days_back) · serie temporal",
        "get_top_books(limit_count) · ranking"
      ]
    },
    {
      "dot": "amber",
      "title": "Consumo sin leak del vendor",
      "items": [
        "DataGateway.rpc() abstrae la llamada",
        "AnalyticsRepositoryImpl mapea a entidades",
        "AdminAnalyticsBloc expone estado a la UI"
      ]
    }
  ],
  "stages": [
    {
      "label": "Origen · Cliente"
    },
    {
      "label": "Use cases"
    },
    {
      "label": "Tablas · Postgres"
