{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Storage: covers vs chapters y cleanup",
    "locale": "en",
    "visual_preset": "classic",
    "quality_profile": "standard",
    "animation": "trace",
    "viewBox": [
      1920,
      1000
    ],
    "views": [
      {
        "id": "upload",
        "label": "Upload por bucket",
        "focus": [
          "scan_edit",
          "book_forms",
          "upload_content",
          "upload_image",
          "covers_bucket",
          "chapters_bucket"
        ],
        "note": "El contenido de capítulos (txt/html, 10MB) sube a chapters; las portadas (jpg/png/webp, 5MB) a covers."
      },
      {
        "id": "cleanup",
        "label": "Cleanup huérfanos",
        "focus": [
          "book_repo",
          "data_gw",
          "storage_gw",
          "covers_bucket",
          "chapters_bucket"
        ],
        "note": "deleteBook usa bookContentTree para saber qué limpiar en Storage antes del DELETE."
      },
      {
        "id": "lectura",
        "label": "Lectura con cache",
        "focus": [
          "chapter_repo",
          "storage_gw",
          "chapters_bucket"
        ],
        "note": "downloadContent intenta ChapterCache (disco, TTL 7d) antes de Storage."
      }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "Buckets separados",
      "items": [
        "chapters: contenido .md/.txt (10MB) · filename $userId/millis.ext",
        "covers: portadas jpg/jpeg/png/webp (5MB) · filename $userId/millis.ext",
        "StorageGateway: upload · download · remove · publicUrl · pathFromUrl"
      ]
    },
    {
      "dot": "violet",
      "title": "Cleanup con bookContentTree",
      "items": [
        "deleteBook consulta 'cover, tooks(chapters(content), cover)'",
        "Limpia covers y contenido en Storage antes del DELETE cascade",
        "El contrato de retorno: publicUrl para capítulos, filename para portadas"
      ]
    },
    {
      "dot": "amber",
      "title": "Lectura y caché",
      "items": [
        "downloadContent valida cache en disco (TTL 7 días) antes de Storage",
        "ChapterCache: has / read / save / clear",
        "RLS Storage con ownership por carpeta $userId (fixes 2026-07)"
      ]
    }
  ],
  "stages": [
